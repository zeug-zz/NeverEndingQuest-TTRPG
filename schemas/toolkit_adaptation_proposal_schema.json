{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neverendingquest.local/schemas/toolkit_adaptation_proposal.v1.json",
  "title": "NeverEndingQuest Toolkit Adaptation World Proposal Ledger v1",
  "description": "Attempt-scoped, unapproved world-narrative proposals. This ledger is not canon and cannot mutate runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "attempt_id",
    "attempt_number",
    "revision_number",
    "created_at",
    "status",
    "context_status",
    "approval_status",
    "approval_required",
    "approval_path",
    "auto_apply",
    "apply_allowed",
    "canon_write_allowed",
    "registry_write_allowed",
    "mechanical_write_allowed",
    "world_hooks_proposed",
    "continuations_proposed",
    "proposal_count",
    "proposals",
    "provenance",
    "model_metadata",
    "diagnostics",
    "ledger_hash"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["toolkit_adaptation_proposal.v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["world_narrative_proposals"]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "revision_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "type": "string",
      "enum": ["pending_approval", "no_proposals"]
    },
    "context_status": {
      "type": "string",
      "enum": ["available", "degraded", "unavailable", "invalid"]
    },
    "approval_status": {
      "type": "string",
      "enum": ["pending"]
    },
    "approval_required": {
      "const": true
    },
    "approval_path": {
      "type": "string",
      "enum": ["world_narrative_approval"]
    },
    "auto_apply": {
      "const": false
    },
    "apply_allowed": {
      "const": false
    },
    "canon_write_allowed": {
      "const": false
    },
    "registry_write_allowed": {
      "const": false
    },
    "mechanical_write_allowed": {
      "const": false
    },
    "world_hooks_proposed": {
      "type": "boolean"
    },
    "continuations_proposed": {
      "type": "boolean"
    },
    "proposal_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "proposals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          {"$ref": "#/definitions/world_hook_proposal"},
          {"$ref": "#/definitions/continuation_proposal"}
        ]
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "model_metadata": {
      "$ref": "#/definitions/model_metadata"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/definitions/diagnostic"}
    },
    "ledger_hash": {
      "$ref": "#/definitions/sha256"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640
    },
    "source_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "model_metadata": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 160},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "parameter_profile": {"type": "string", "minLength": 1, "maxLength": 120},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "reasoning_effort": {"type": "string", "minLength": 1, "maxLength": 32},
        "verbosity": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "world_context_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_version",
        "context_version",
        "context_status",
        "fallback_status",
        "world_seed_status",
        "read_only",
        "provider_free",
        "raw_context_included",
        "canon_write_allowed",
        "registry_write_allowed",
        "mechanical_write_allowed"
      ],
      "properties": {
        "provenance_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "context_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "context_status": {"type": "string", "enum": ["available", "fallback", "unavailable"]},
        "fallback_status": {"type": "string", "minLength": 1, "maxLength": 80},
        "world_seed_status": {"type": "string", "enum": ["available", "unavailable", "invalid"]},
        "world_seed_version": {"type": ["string", "null"], "maxLength": 120},
        "world_seed_hash": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
        "context_hash": {"anyOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
        "selected_module": {"type": ["string", "null"], "maxLength": 140},
        "read_only": {"type": "boolean"},
        "provider_free": {"type": "boolean"},
        "raw_context_included": {"type": "boolean"},
        "canon_write_allowed": {"type": "boolean"},
        "registry_write_allowed": {"type": "boolean"},
        "mechanical_write_allowed": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_title",
        "source_hash",
        "source_path",
        "adaptation_mode",
        "dossier_hash",
        "world_context_provenance"
      ],
      "properties": {
        "source_title": {"$ref": "#/definitions/source_title"},
        "source_hash": {"$ref": "#/definitions/sha256"},
        "source_path": {"$ref": "#/definitions/relative_path"},
        "source_profile": {"type": "string", "minLength": 1, "maxLength": 32},
        "adaptation_mode": {"type": "string", "enum": ["llm_adaptation"]},
        "dossier_hash": {"$ref": "#/definitions/sha256"},
        "world_context_provenance": {"$ref": "#/definitions/world_context_provenance"}
      }
    },
    "proposal_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_type",
        "source_field",
        "approval_status",
        "apply_allowed",
        "content"
      ],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^(hook|continuation)-[0-9a-f]{24}$"},
        "proposal_type": {"type": "string", "enum": ["world_hook", "continuation"]},
        "source_field": {"type": "string", "enum": ["world_narrative_hooks", "continuity_hints"]},
        "approval_status": {"const": "pending"},
        "apply_allowed": {"const": false},
        "content": {"type": "object"}
      }
    },
    "world_hook_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "relationship"],
      "properties": {
        "hook": {"$ref": "#/definitions/bounded_text"},
        "relationship": {"$ref": "#/definitions/bounded_text"},
        "proposed_follow_up": {"$ref": "#/definitions/bounded_text"}
      }
    },
    "continuation_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hint", "scope"],
      "properties": {
        "hint": {"$ref": "#/definitions/bounded_text"},
        "scope": {"$ref": "#/definitions/bounded_text"},
        "related_module": {"$ref": "#/definitions/bounded_text"},
        "entity": {"$ref": "#/definitions/bounded_text"}
      }
    },
    "world_hook_proposal": {
      "allOf": [
        {"$ref": "#/definitions/proposal_common"},
        {
          "type": "object",
          "properties": {
            "proposal_type": {"const": "world_hook"},
            "source_field": {"const": "world_narrative_hooks"},
            "content": {"$ref": "#/definitions/world_hook_content"}
          }
        }
      ]
    },
    "continuation_proposal": {
      "allOf": [
        {"$ref": "#/definitions/proposal_common"},
        {
          "type": "object",
          "properties": {
            "proposal_type": {"const": "continuation"},
            "source_field": {"const": "continuity_hints"},
            "content": {"$ref": "#/definitions/continuation_content"}
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 120},
        "message": {"type": "string", "minLength": 1, "maxLength": 320},
        "path": {"type": "string", "maxLength": 160},
        "severity": {"type": "string", "enum": ["warning", "error"]}
      }
    }
  }
}
