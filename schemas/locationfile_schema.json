{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "areaName": { "type": "string" },
      "areaId": { "type": "string" },
      "areaDescription": { "type": "string" },
      "areaType": { "type": "string" },
      "dangerLevel": { "type": "string" },
      "recommendedLevel": { "type": "integer" },
      "spatialContractVersion": { "type": "integer", "minimum": 1 },
      "locations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "locationId": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "coordinates": {
              "type": "string",
              "pattern": "^X[0-9]+Y[0-9]+$"
            },
            "aliases": {
              "type": "array",
              "items": { "type": "string" }
            },
            "tactical_grid": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 9,
              "maxItems": 9
            },
            "sceneAuthority": {
              "type": "object",
              "properties": {
                "presentSceneAnchors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "anchorId": { "type": "string" },
                      "aliases": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                      },
                      "category": { "type": "string" },
                      "foreshadowAllowed": { "type": "boolean" }
                    },
                    "required": ["anchorId", "aliases"]
                  }
                }
              }
            },
            "tacticalFeatures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "featureId": { "type": "string", "minLength": 1 },
                  "name": { "type": "string" },
                  "kind": { "const": "cover" },
                  "coverType": { "type": "string", "enum": ["half", "three_quarters"] },
                  "usableBy": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": ["featureId", "name", "kind", "coverType", "usableBy"],
                "additionalProperties": false
              }
            },
            "connectivity": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["locationId", "name", "description"]
        }
      }
    },
    "required": ["areaName", "areaId", "locations"]
  }
