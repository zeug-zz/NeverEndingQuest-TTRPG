{
  "provider": "openrouter",
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "model": "openai/gpt-6-luna",
  "parameters": {
    "temperature": 1.0,
    "top_p": 1.0,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0,
    "max_tokens": 4096,
    "stream": false,
    "response_format": {"type": "json_object"},
    "tools": [],
    "tool_choice": "none",
    "provider": {"allow_fallbacks": false}
  },
  "reasoning_policy": {
    "request_field_sent": false,
    "setting": "model_default",
    "justification": "Route-specific reasoning controls and an owner-approved effort are unconfirmed; do not guess or alter the selected model default."
  },
  "transport_policy": {
    "request_timeout_seconds": 180.0,
    "generation_dispatches_per_scene": 1,
    "automatic_retries": 0,
    "redirects": false,
    "fallbacks": false,
    "model_continuation": false,
    "tools_enabled": false
  }
}
