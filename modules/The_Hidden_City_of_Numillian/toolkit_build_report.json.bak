            },
            "shuluth_ancient_mind_warder_of_numillian": {
              "name": "Shuluth, ancient mind-warder of Numillian",
              "role": "",
              "faction": "",
              "description": "A terrifyingly old intelligence anchored in the city's ward tradition, present here through layered projections, dreams, or psychic echoes. Its voice is calm, immense, and impossible to fully trust.",
              "appears_in": [
                {
                  "area": "CD003",
