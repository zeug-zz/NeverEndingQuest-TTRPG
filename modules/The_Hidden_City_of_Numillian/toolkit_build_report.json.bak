              ]
            },
            "ilyra_wardkeeper_adjudicator": {
              "name": "Ilyra, Wardkeeper adjudicator",
              "role": "",
              "faction": "",
              "description": "A stern adjudicator stationed here to observe whether travelers can navigate the trialway without relying on brute force. She records every misstep and every act of restraint.",
              "appears_in": [
                {
                  "area": "HF002",
                  "location": "G03"
                }
              ],
              "aliases": [
                "Ilyra, Wardkeeper adjudicator"
              ]
            },
            "kobe_a_guarded_resident_tied_to_the_vault": {
              "name": "Kobe, a guarded resident tied to the vault",
              "role": "",
              "faction": "",
              "description": "A tense resident kept under warded protection, treated as both witness and key to the vault's preservation logic. They know the chamber's routines and are frightened of what the memories might reveal.",
              "appears_in": [
                {
                  "area": "HF002",
                  "location": "G02"
                }
              ],
              "aliases": [
                "Kobe, a guarded resident tied to the vault"
              ]
            },
            "elaris_a_diplomat_of_the_secrecy_council": {
              "name": "Elaris, a diplomat of the Secrecy Council",
              "role": "",
              "faction": "",
              "description": "A polished envoy with carefully measured speech, sent to assess whether the hidden city can survive exposure without collapsing into panic.",
              "appears_in": [
                {
                  "area": "VA001",
                  "location": "G03"
                },
                {
                  "area": "SS005",
                  "location": "SS005-G01"
                }
              ],
              "aliases": [
                "Elaris, a diplomat of the Secrecy Council"
              ]
            },
            "veyrun_a_wardkeeper_captain": {
              "name": "Veyrun, a Wardkeeper captain",
              "role": "",
              "faction": "",
              "description": "A disciplined officer overseeing passage through the district's controlled routes. Veyrun is practical, sharp-eyed, and torn between duty to secrecy and concern that the city's barriers are becoming dangerous to maintain.",
              "appears_in": [
                {
                  "area": "CD003",
                  "location": "G03"
                },
                {
                  "area": "LD004",
                  "location": "G02"
                }
              ],
              "aliases": [
                "Veyrun, a Wardkeeper captain"
              ]
            },
            "kobe_endangered_key_witness": {
              "name": "Kobe, endangered key witness",
              "role": "",
              "faction": "",
              "description": "A guarded resident who has seen enough of the vault crisis to become a target. Kobe is cautious, exhausted, and terrified that speaking plainly will endanger everyone nearby.",
              "appears_in": [
                {
                  "area": "CD003",
                  "location": "G02"
                }
              ],
              "aliases": [
                "Kobe, endangered key witness"
              ]
            },
            "shuluth_the_hidden_manipulator": {
              "name": "Shuluth, the hidden manipulator",
              "role": "",
              "faction": "",
              "description": "An unseen strategist working through intermediaries, records, and quiet pressure. Within the barracks, Shuluth's influence is felt as missing reports, altered orders, and a chilling sense that someone has anticipated every move.",
              "appears_in": [
                {
                  "area": "CD003",
                  "location": "G04"
                }
              ],
              "aliases": [
                "Shuluth, the hidden manipulator"
              ]
            },
            "arannis_vault_scholar_and_alarmed_archivist": {
              "name": "Arannis, vault scholar and alarmed archivist",
              "role": "",
              "faction": "",
              "description": "A frazzled scholar carrying notes, fragments, and urgent warnings about a deeper vault crisis.",
