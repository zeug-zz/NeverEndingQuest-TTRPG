            },
            "kobe_the_life_at_the_center_of_the_crisis": {
              "name": "Kobe, the life at the center of the crisis",
              "role": "",
              "faction": "",
              "description": "A frightened but resilient resident who has become the focal point of the vault crisis, carrying memories and psychic residue that can stabilize or doom the wards below.",
              "appears_in": [
                {
                  "area": "LD004",
