            "letharel_the_silent_border_warden": {
              "name": "Letharel, the silent border warden",
              "role": "",
              "faction": "",
              "description": "A watchful border sentinel who studies tracks, wards, and travelers alike, using gestures and carved slate to communicate in near silence.",
