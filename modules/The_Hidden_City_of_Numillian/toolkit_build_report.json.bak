              "name": "Shuluth, unseen voice behind the wards",
              "role": "",
              "faction": "",
              "description": "An unseen, disembodied presence that speaks through the hall's rotating rings and broken lenses, offering guidance that is always too precise to be trusted.",
              "appears_in": [
                {
                  "area": "HF002",
                  "location": "G04"
                }
              ],
              "aliases": [
                "Shuluth, unseen voice behind the wards"
              ]
            },
            "seryn_vale_keeper_of_the_first_trial": {
              "name": "Seryn Vale, keeper of the first trial",
              "role": "",
              "faction": "",
              "description": "A calm, exacting guardian who oversees the entry rites and judges whether visitors are ready for Numillian's psychic tests.",
              "appears_in": [
                {
                  "area": "VA001",
                  "location": "G04"
                },
                {
