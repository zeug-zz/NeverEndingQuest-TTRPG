              ]
            },
            "thalanis_secrecy_council_examiner": {
              "name": "Thalanis, Secrecy Council examiner",
              "role": "",
              "faction": "",
              "description": "A severe evaluator who tests claims, motives, and proof with relentless precision.",
              "appears_in": [
                {
                  "area": "VA001",
                  "location": "G03"
                },
                {
                  "area": "LD004",
