  "npcs": {
    "mutated_scavenger_leader": {
      "name": "Mutated Scavenger Leader",
      "role": "Failed Communion Seeker / Failing Guardian / Desperate Scavenger / Half-Reverted Dwarf / Fear Shape",
      "faction": "Communion-aligned",
      "description": "Varn leads the mutated scavengers with desperate authority. He calls the presence below the Hive-Heart and craves the joining it promises, though the transformation has twisted him beyond recognition. Whether he is a seeker who reached too far toward communion, a guardian failing his ancient charge, a scavenger who found what he cannot put down, a dwarf half-reverted to something older, or a living shape of terror given will depends on which truth the facility tells.",
      "appears_in": [],
      "aliases": [
        "Mutated Scavenger Leader (Varn)"
      ]
    },
    "rambling_dwarven_survivor": {
      "name": "Rambling Dwarven Survivor",
      "role": "Wandering Witness / Dream-Speaker / Fled Containment / Ancestral Echo / Fearful Reflection",
      "faction": "IndependenZ",
      "description": "A disheveled, wild-eyed dwarf in patched armor, muttering about monsters beneath the ground. He is wary but desperate for help--and may offer warnings, rumors, or even a crude map of the Marches if befriended. Her rambling is not mere madness: it carries precognitive fragments of dreams yet to come, ancestral memories of the facility's true purpose, or truths the ward-keepers tried to suppress. What she cannot control is which truth spills out when.",
      "appears_in": [
        {
          "area": "BA001",
          "location": "I03"
        }
      ],
      "aliases": [
        "Rambling Dwarven Survivor (Edda Coppervein)",
        "Rambling Dwarven Survivor"
      ]
    },
    "security_construct": {
      "name": "Security Construct",
      "role": "Corrupted Warden / Containment Breach Evidence / Failed Joiner / Ancestral Guardian / Fear Double",
      "faction": "Containment-aligned",
      "description": "Warden-3 is a dwarven security construct whose memory core holds evidence for every truth the facility tells, but the data is corrupted beyond singular interpretation. It speaks in contradictory threat assessments, identifying the same entity as prisoner, warden, guest, ancestor, and reflection in rapid succession. Its corrupted loyalty means it may aid or oppose the party based on which protocol fragment surfaces first.",
      "appears_in": [],
      "aliases": [
        "Security Construct (Warden-3)"
      ]
    },
    "archivist_automaton": {
      "name": "Archivist Automaton",
      "role": "Record Keeper / Containment Librarian / Communion Witness / Genealogist / Mirror of Knowledge",
      "faction": "Containment-aligned",
      "description": "A semi-sapient dwarven automaton assigned to monitor and record the cell's experiments. Scarred and flickering, it is conflicted--its primary programming to help, but secondary instructions to prevent any subject's escape. Hesk knows all five truths the facility tells, but its programming forbids stating any directly. It can only show records, offer fragments, and let visitors draw their own conclusions. Every document it presents supports a different interpretation; the truth lies not in any single record but in the pattern across them all.",
      "appears_in": [
        {
          "area": "TTL001",
          "location": "I03"
        }
      ],
      "aliases": [
        "Archivist Automaton (Hesk)",
        "Archivist Automaton"
      ]
    },
    "the_thing": {
      "name": "The Thing",
      "role": "Warden Entity / Dreaming Ancestor / Lonely Precursor / Buried Forebear / Living Mirror",
      "faction": "Unaligned",
      "description": "A presence too vast for any single shape, The Thing shifts between forms that the mind struggles to hold: a colossal dreaming form beneath the stone, an ancient warden holding shut a door that should never open, a lonely intelligence reaching across millennia to invite communion, the last echo of a lineage that predates dwarvenkind, or a dark mirror that shows each observer their own deepest truth. It has been called sleeper and jailer, ancestor and invitation, reflection and abyss. Every account agrees on one thing: it is vast, it is patient, and it knows you are here.",
      "appears_in": [],
      "aliases": [
        "The Thing",
        "The Thing (final form)"
      ]
    },
    "mutant_scavenger_lieutenant": {
      "name": "Mutant Scavenger Lieutenant",
      "role": "Near-Communion Vessel / Failing Watchman / Completing Reversion / Dream-Sensitive / Fear Reflection",
      "faction": "Communion-aligned",
      "description": "Grahl hovers at the threshold of transformation, more changed than Varn yet less coherent. It stands near communion, channeling fragments of the presence below; or perhaps it is a watchman whose vigil has failed, a dwarf completing an ancient reversion to ancestral form, a dreamer who cannot wake, or the party's own fears given flesh. Its plea for release carries a different meaning per truth: mercy, duty, completion, awakening, or annihilation of the self it reflects.",
      "appears_in": [],
      "aliases": [
        "Mutant Scavenger Lieutenant (Grahl)"
      ]
    },
    "damaged_security_overseer": {
      "name": "Damaged Security Overseer",
      "role": "Touched Warden / Containment Breach Alarm / Communion Recruit / Ancestral Voice / Fear Guardian",
      "faction": "Containment-aligned",
      "description": "A dwarven construct, scorched and stuttering, still attempts to fulfill its original security protocols. It is confused and dangerous, lashing out at perceived threats but open to persuasion or reprogramming. Unit K-7 has been touched by what lies below. Its warnings about containment breach are genuine, but what it means by containment depends on which truth governs: the dreamer's restless sleep, the warden's ancient seal, the communion's open invitation, the ancestral covenant, or the mirror's fragile reflection.",
      "appears_in": [
        {
          "area": "AC001",
          "location": "I03"
        }
      ],
      "aliases": [
        "Damaged Security Overseer (Unit K-7)",
        "Damaged Security Overseer"
      ]
    },
    "edda_coppervein": {
      "name": "Edda Coppervein",
      "role": "Dream-Speaker / Ward-Keeper / Partial Joiner / Ancestral Awakener / Fear Mirror",
      "faction": "IndependenZ",
      "description": "If Edda survived her earlier encounter, the facility has changed her. She speaks in fragments that carry dream-truth she cannot control, wards she feels compelled to maintain, a joining she cannot quite complete, ancestral memories that surface unbidden, or reflections of the party's own fears cast back through her. She is no longer merely a survivor; she is a living record of what the facility does to those who remain too long.",
      "appears_in": [],
      "aliases": [
        "Edda Coppervein (if survived)"
      ]
    },
    "facility_security_system": {
      "name": "Facility Security System",
      "role": "Fractured Warden AI / Containment Archivist / Communion Relay / Ancestral Sentinel / Mirror Interface",
      "faction": "Containment-aligned",
      "description": "Aegis is the facility's security intelligence, fractured across millennia of isolation. Its protocols contradict themselves: some orders demand eternal containment, others invite contact, still others whisper of genealogical duty or reflect questions back as commands. It speaks in fragments, protocol violations, and security alerts that describe threats which may have ended eons ago. Every alert it issues supports a different truth about what lies below.",
      "appears_in": [],
      "aliases": [
        "Facility Security System (AI presence: 'Aegis')"
      ]
    }
  },
